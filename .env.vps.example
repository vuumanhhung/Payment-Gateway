# Copy file này thành .env.vps trên VPS.
# Dùng: openssl rand -hex 32
GATEWAY_API_TOKEN=THAY_BANG_TOKEN_NGAU_NHIEN_TOI_THIEU_32_KY_TU

# Gateway chỉ quét khi Market gọi POST /gateways/scan.
GATEWAY_AUTO_CRON=false
GATEWAY_PRELOGIN=false

# ACB xác thực thiết bị mới qua terminal SSH/container.
ACB_MANUAL_LOGIN=false
ACB_SAFEKEY_CONSOLE=true

PAYMENT_CHECK_TIMEOUT_SEC=30
PAYMENT_CHECK_INTERVAL_SEC=15
PAYMENT_CHECK_MAX_ATTEMPTS=1
